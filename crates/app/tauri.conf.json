{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lifefs",
  "identifier": "dev.ujjwalkumar.lifefs",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "ui/dist",
    "beforeDevCommand": { "script": "bun --bun run dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "bun --bun run build", "cwd": "../.." }
  },
  "app": {
    "windows": [{ "title": "lifefs", "width": 720, "height": 520 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Collects what you owe from Slack and meetings into your vault",
    "copyright": "© 2026 Ujjwal Kumar. MIT OR Apache-2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
